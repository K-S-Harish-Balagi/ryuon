{
  "app-id": "io.github.k_s_harish_balagi.Ryuon",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "ryuon",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--filesystem=xdg-music"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/ryuon/cargo",
      "CARGO_NET_OFFLINE": "true",
      "RUST_BACKTRACE": "1"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "ryuon",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": [
        "-Dprofile=default"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "skip": [
            ".flatpak-builder",
            "_build",
            "_flatpak-build",
            "_dev-build",
            ".devbuild",
            ".git",
            "_repo",
            "build-dir",
            "tools/__pycache__"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ],
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ]
}
