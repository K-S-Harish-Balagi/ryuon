<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A plain window theme: Compose draws everything; the dark background avoids a white flash at start -->
    <style name="Theme.Ryuon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="window_dark">#242424</color>
</resources>
