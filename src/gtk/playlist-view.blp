using Gtk 4.0;
using Adw 1;

template $RyuonPlaylistView: Widget {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      ToggleButton search_button {
        icon-name: "system-search-symbolic";
        action-name: "queue.search";
        valign: center;
        tooltip-text: _("Search Songs in the Playlist");
      }

      title-widget: Box queue_length_box {
        orientation: vertical;
        valign: center;

        Label {
          ellipsize: end;
          label: _("Playlist");

          styles [
            "heading",
          ]
        }

        Label queue_length_label {
          ellipsize: end;

          styles [
            "caption",
          ]
        }
      };

      [end]
      Button back_button {
        visible: false;
        icon-name: "go-previous-symbolic";
        action-name: "queue.toggle";
        valign: center;
        tooltip-text: _("Close the Playlist");
      }

      [end]
      MenuButton view_button {
        icon-name: "view-sort-ascending-symbolic";
        menu-model: view_menu;
        valign: center;
        tooltip-text: _("View and Sort");

        accessibility {
          label: C_("a11y", "View and sort");
        }
      }

      [end]
      ToggleButton select_button {
        icon-name: "selection-mode-symbolic";
        action-name: "queue.select";
        valign: center;
        tooltip-text: _("Select Songs in the Playlist");
      }
    }

    [top]
    Box view_tabs {
      homogeneous: true;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 6;

      ToggleButton songs_tab {
        label: _("Songs");
        active: true;
        tooltip-text: _("Show Every Song");
      }

      ToggleButton folders_tab {
        label: _("Folders");
        group: songs_tab;
        tooltip-text: _("Show Folders, One Row Each");
      }

      styles [
        "linked",
        "view-tabs",
      ]
    }

    [top]
    SearchBar playlist_searchbar {
      child: SearchEntry playlist_searchentry {
        placeholder-text: _("Search songs");
        hexpand: true;

        accessibility {
          label: C_("a11y", "Search");
          description: C_("a11y", "Type to search songs");
        }
      };
    }

    content: Overlay playlist_overlay {
      [overlay]
      ProgressBar playlist_progress {
        valign: start;
        hexpand: true;
        visible: false;

        styles [
          "osd",
        ]
      }

      Stack playlist_stack {
        transition-type: crossfade;

        StackPage {
          name: "songs";

          child: ScrolledWindow {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            propagate-natural-height: true;
            vexpand: true;

            child: ListView queue_view {
              single-click-activate: true;

              styles [
                "navigation-sidebar",
              ]
            };
          };
        }

        StackPage {
          name: "folders";

          child: ScrolledWindow folder_scroller {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            vexpand: true;

            child: ListBox folder_list {
              selection-mode: none;

              accessibility {
                label: C_("a11y", "Folders");
              }

              styles [
                "navigation-sidebar",
              ]
            };
          };
        }
      }
    };

    [bottom]
    ActionBar queue_actionbar {
      revealed: false;

      styles [
        "flat",
      ]

      Button queue_select_all_button {
        icon-name: "edit-select-all-symbolic";
        tooltip-text: _("Select All Songs");
      }

      [center]
      Label queue_selected_label {
        styles [
          "caption",
        ]
      }

      [end]
      Button queue_remove_button {
        icon-name: "app-remove-symbolic";
        tooltip-text: _("Remove Selected Songs");
      }
    }

    styles [
      "playlist-background",
    ]
  }
}

menu view_menu {
  section {
    label: _("Sort Folders By");

    item {
      label: _("_A–Z");
      action: "win.library-sort";
      target: "name";
    }

    item {
      label: _("_Newest First");
      action: "win.library-sort";
      target: "newest";
    }

    item {
      label: _("_Most Songs");
      action: "win.library-sort";
      target: "most-songs";
    }

    item {
      label: _("_Recently Played");
      action: "win.library-sort";
      target: "recent";
    }

    item {
      label: _("M_anual Order");
      action: "win.library-sort";
      target: "manual";
    }
  }

  section {
    item {
      label: _("Reset to Folder _Order");
      action: "win.reset-order";
    }
  }

  section {
    item {
      label: _("_Clean Up Names");
      action: "app.tidy-names";
    }

    item {
      label: _("Music _Library…");
      action: "win.preferences";
    }
  }
}
