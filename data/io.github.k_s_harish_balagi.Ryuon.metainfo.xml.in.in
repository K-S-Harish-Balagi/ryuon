<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Ryuon</name>
  <summary>Plays your music, folder by folder</summary>
  <description>
    <p>
      Ryuon is a local music player for people who keep their music in folders. Choose your
      music folder once and Ryuon plays it one folder after another, picking up where you
      stopped the next time you open it.
    </p>
    <ul>
      <li>Shows where you are: folder 7 of 139, song 4 of 10, and what plays next</li>
      <li>Play next, move songs and whole folders, with undo</li>
      <li>Sort folders by name, newest, most songs or recently played, or keep your own order</li>
      <li>Folders view to jump to any album</li>
      <li>Tidies messy names on screen: no site tags, bitrates or underscores</li>
      <li>Optionally renames the files themselves, with a preview and full undo</li>
      <li>Colors the window from the album art, works on phones and desktops</li>
      <li>Media keys and desktop media controls</li>
    </ul>
    <p>Ryuon is a fork of Amberol by Emmanuele Bassi.</p>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#90c0ff</color>
    <color type="primary" scheme_preference="dark">#003681</color>
  </branding>
  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>
  <developer_name>Harish</developer_name>
  <developer id="io.github.k_s_harish_balagi">
    <name>Harish</name>
  </developer>
  <url type="homepage">https://github.com/K-S-Harish-Balagi/ryuon</url>
  <url type="vcs-browser">https://github.com/K-S-Harish-Balagi/ryuon</url>
  <url type="bugtracker">https://github.com/K-S-Harish-Balagi/ryuon/issues</url>
  <translation type="gettext">ryuon</translation>
  <custom>
    <value key="Purism::form_factor">mobile</value>
  </custom>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/K-S-Harish-Balagi/ryuon/main/data/screenshots/playing.png</image>
      <caption>Playing a library folder by folder</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/K-S-Harish-Balagi/ryuon/main/data/screenshots/folders.png</image>
      <caption>The Folders view</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/K-S-Harish-Balagi/ryuon/main/data/screenshots/preferences.png</image>
      <caption>Library settings</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/K-S-Harish-Balagi/ryuon/main/data/screenshots/song-info.png</image>
      <caption>Song Info: where a song comes from</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.4.0" date="2026-10-17">
      <description>
        <p>Ryuon now runs on Windows 10 and 11 (beta): an installer and a portable version.</p>
        <ul>
          <li>Songs are recognised by their file type on every system</li>
          <li>The Add Song window lists audio files by extension as well</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-10-17">
      <description>
        <ul>
          <li>Renaming files outside the Music folder asks for permission in the app: choose Allow once in the folder window, no terminal needed</li>
          <li>Clear messages when a drive or folder is read-only, and how to fix it</li>
          <li>The app icon shows on every desktop and dock, at the same size as other apps</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-15">
      <description>
        <ul>
          <li>Song Info: right-click a song to see its folder, file, format and size</li>
          <li>Songs and Folders tabs, and a View and Sort menu in the playlist</li>
          <li>Folders view: numbers, covers, played folders ticked, the playing folder opens to its songs</li>
          <li>A Settings button, and Settings arranged as Location, Playback order, Names and Playback</li>
          <li>Tidy Names: a before and after preview with clashes marked</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-11">
      <description>
        <ul>
          <li>Music library: choose it once, play folder by folder, resume where you stopped</li>
          <li>Reorder: play next, move songs and folders, undo</li>
          <li>Sort folders and a Folders view</li>
          <li>Tidy names on screen, and optional renaming on disk with undo</li>
          <li>Preferences window</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-10">
      <description>
        <ul>
          <li>First release of Ryuon, a rebranded fork of Amberol 2026.1</li>
        </ul>
      </description>
    </release>
  </releases>
  <kudos>
    <kudo>ModernToolkit</kudo>
    <kudo>Notifications</kudo>
  </kudos>
  <content_rating type="oars-1.1"/>
  <provides>@APPLICATION_ID@.desktop</provides>
</component>
