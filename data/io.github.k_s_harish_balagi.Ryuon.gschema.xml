<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="ryuon">
  <enum id="io.github.k_s_harish_balagi.Ryuon.ReplayGainMode">
    <value nick="album" value="0"/>
    <value nick="track" value="1"/>
    <value nick="off" value="2"/>
  </enum>
	<schema id="io.github.k_s_harish_balagi.Ryuon" path="/io/github/k_s_harish_balagi/Ryuon/">
	  <key name="window-width" type="i">
	    <default>600</default>
	  </key>
	  <key name="window-height" type="i">
	    <default>300</default>
	  </key>
	  <key name="enable-recoloring" type="b">
	    <default>true</default>
	  </key>
    <key name="replay-gain" enum="io.github.k_s_harish_balagi.Ryuon.ReplayGainMode">
      <default>'off'</default>
    </key>
	  <key name="background-play" type="b">
	    <default>true</default>
	  </key>
	  <key name="library-path" type="s">
	    <default>''</default>
	    <summary>Music library folder</summary>
	    <description>The folder that holds your music, one subfolder per album. Empty when no library is set.</description>
	  </key>
	  <key name="resume-uri" type="s">
	    <default>''</default>
	    <summary>Song to resume</summary>
	    <description>The song that was playing from the music library when the application last ran.</description>
	  </key>
	  <key name="resume-position" type="t">
	    <default>0</default>
	    <summary>Position to resume</summary>
	    <description>How far into the song to resume, in seconds.</description>
	  </key>
	  <key name="library-autoload" type="b">
	    <default>false</default>
	    <summary>Open the library at start</summary>
	    <description>Open the music library automatically when the application starts with an empty queue.</description>
	  </key>
	</schema>
</schemalist>
