#, rust-format
msgid "{} minute"
msgid_plural "{} minutes"
msgstr[0] "{} minuto"
msgstr[1] "{} minuti"

#: src/window.rs:2660
#, rust-format
msgid "{hours} hour {minutes} remaining"
msgid_plural "{hours} hours {minutes} remaining"
msgstr[0] "{hours} ora e {minutes} rimanenti"
