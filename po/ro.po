msgstr "Nicio melodie disponibilă"

#: src/window.rs:1750
msgid "No songs found"
msgstr "Nu s-au găsit melodii"

#: src/window.rs:1800
msgid "Added a new song"
msgstr "S-a adăugat o melodie nouă"

#: src/window.rs:1801
msgid "Play"
msgstr "Redare"

#. Translators: the `{}` must be left unmodified;
#. it will be expanded to the number of songs added
#. to the playlist
#: src/window.rs:1810
#, rust-format
msgid "Added one song"
msgid_plural "Added {} songs"
msgstr[0] "S-a adăugat o melodie"
msgstr[1] "S-au adăugat {} melodii"
msgstr[2] "S-au adăugat {} de melodii"

#: src/window.rs:1818
#, rust-format
msgid "Skipped one duplicate"
msgid_plural "Skipped {} duplicates"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: src/window.rs:2552
msgid "Unable to access dropped files"
msgstr "Nu se pot accesa fișierele așezate"

#: src/window.rs:2649
#, rust-format
msgid "{} minute"
msgid_plural "{} minutes"
msgstr[0] "{} minut"
msgstr[1] "{} minute"
msgstr[2] "{} de minute"

#: src/window.rs:2660
#, rust-format
msgid "{hours} hour {minutes} remaining"
msgid_plural "{hours} hours {minutes} remaining"
msgstr[0] "{hours} oră {minutes} rămase"
msgstr[1] "{hours} ore {minutes} rămase"
msgstr[2] "{hours} de ore {minutes} rămase"

#. Translators: the '{}' must be left unmodified, and
#. it will be replaced by the number of minutes remaining
#. in the playlist
#: src/window.rs:2670
#, rust-format
msgid "{} minute remaining"
msgid_plural "{} minutes remaining"
msgstr[0] "{} minut rămas"
msgstr[1] "{} minute rămase"
msgstr[2] "{} de minute rămase"

#: src/window.rs:2788
msgid "No song selected"
msgstr "Nicio melodie selecționată"

#. Translators: The '{}' must be left unmodified, and
#. it is expanded to the number of songs selected
#: src/window.rs:2793
#, rust-format
msgid "{} song selected"
msgid_plural "{} songs selected"
msgstr[0] "{} melodie selecționată"
msgstr[1] "{} melodii selecționate"
msgstr[2] "{} de melodii selecționate"

#. Translators: `{title}` and `{artist}` must be left
#. untranslated; they will expand to the title and
#. artist of the currently playing song, respectively
#: src/window.rs:2849
#, rust-format
msgid "Currently playing “{title}” by “{artist}”"
msgstr "Acum se redă „{title}” de „{artist}”"

#: src/window.rs:2886
msgid "Unable to open folder"
msgstr "Dosarul nu poate fi deschis"

