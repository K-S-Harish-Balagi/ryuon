msgstr "Geen toegang tot ingesleepte bestanden"

#: src/window.rs:2649
#, rust-format
msgid "{} minute"
msgid_plural "{} minutes"
msgstr[0] "{} minuut"
msgstr[1] "{} minuten"

#: src/window.rs:2660
#, rust-format
msgid "{hours} hour {minutes} remaining"
msgid_plural "{hours} hours {minutes} remaining"
msgstr[0] "{hours} uur {minutes} resterend"
msgstr[1] "{hours} uur {minutes} resterend"

